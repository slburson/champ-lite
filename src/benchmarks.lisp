(in-package :champ)

;;; Summary (for SBCL, on Apple M2):
;;;   CHAMP reads (19ns) are about 15% slower than CL reads (16ns) at ~40% hit rate
;;;   CHAMP writes (71ns) are 11x slower than CL writes (6.3ns)

(defun build-tables (n)
  (let ((tbl (make-table #+sbcl #'sb-kernel:symbol-hash #-sbcl #'sxhash #'eq))
	(clht (make-hash-table :test 'eq)))
    (dotimes (i n)
      (let ((key (svref *vector-of-symbols* (random (length *vector-of-symbols*))))
	    (value (random 65536)))
	(table-put tbl key value)
	(setf (gethash key clht) value)))
    (values tbl clht)))

(defun exercise-read-harness (n)
  (let ((len (length *vector-of-symbols*)))
    (dotimes (i n)
      (svref *vector-of-symbols* (random len)))))

(defun exercise-champ-write-harness (n)
  (let ((len (length *vector-of-symbols*)))
    (dotimes (i (floor n 200))
      (let ((tbl (make-table #+sbcl #'sb-kernel:symbol-hash #-sbcl #'sxhash #'eq)))
	(declare (ignorable tbl))
	(dotimes (j 200)
	  (svref *vector-of-symbols* (random len))
	  (random 65536))))))

(defun exercise-clht-write-harness (n)
  (let ((len (length *vector-of-symbols*)))
    (dotimes (i (floor n 200))
      (let ((tbl (make-hash-table :test 'eq)))
	(declare (ignorable tbl))
	(dotimes (j 200)
	  (svref *vector-of-symbols* (random len))
	  (random 65536))))))

(defun exercise-champ-reads (n tbl)
  (let ((len (length *vector-of-symbols*)))
    (dotimes (i n)
      (let ((key (svref *vector-of-symbols* (random len))))
	(table-get tbl key)))))

(defun exercise-clht-reads (n clht)
  (let ((len (length *vector-of-symbols*)))
    (dotimes (i n)
      (let ((key (svref *vector-of-symbols* (random len))))
	(gethash key clht)))))

(defun exercise-champ-writes (n)
  (let ((len (length *vector-of-symbols*)))
    (dotimes (i (floor n 200))
      (let ((tbl (make-table #+sbcl #'sb-kernel:symbol-hash #-sbcl #'sxhash #'eq)))
	(dotimes (j 200)
	  (let ((key (svref *vector-of-symbols* (random len)))
		(value (random 65536)))
	    (table-put tbl key value)))))))

(defun exercise-clht-writes (n)
  (let ((len (length *vector-of-symbols*)))
    (dotimes (i (floor n 200))
      (let ((clht (make-hash-table :test 'eq)))
	(dotimes (j 200)
	  (let ((key (svref *vector-of-symbols* (random len)))
		(value (random 65536)))
	    (setf (gethash key clht) value)))))))
